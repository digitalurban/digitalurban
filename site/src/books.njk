---
title: Books
permalink: /books/
---
<section class="dark">
  <div class="dark__in">
    <div class="mono mono--accent" style="padding-bottom:24px">Published</div>
    <div class="book">
      <div class="book__cover">
        <img src="{{ books.lead.cover }}" alt="{{ books.lead.title }}" />
      </div>
      <div class="book__body">
        <h1>{{ books.lead.title }}</h1>
        <p class="book__sub">{{ books.lead.sub }}</p>
        <div class="specs">{% for s in books.lead.specs %}<span>{{ s }}</span>{% endfor %}</div>
        <p class="book__blurb">{{ books.lead.blurb }}</p>
        <div class="mono" style="color:#8d857d">{{ books.lead.authors }}</div>
        <div class="btns">
          {% for l in books.lead.links %}
          <a class="btn {% if l.fill %}btn--fill{% else %}btn--line{% endif %}" href="{{ l.url }}">{{ l.label }}</a>
          {% endfor %}
        </div>
        {% if books.lead.note %}<div class="mono" style="color:#8d857d">{{ books.lead.note }}</div>{% endif %}
      </div>
    </div>
  </div>
</section>

<div class="wrap">
  <div class="book-next">
    <div class="mono mono--accent" style="padding-bottom:20px">Forthcoming</div>
    <div class="book-next__grid">
      {% for b in books.forthcoming %}
      <div class="book-next__item">
        <h2>{{ b.title }}</h2>
        <div class="specs specs--light">{% for s in b.specs %}{% if s %}<span>{{ s }}</span>{% endif %}{% endfor %}</div>
        <p>{{ b.blurb }}</p>
      </div>
      {% endfor %}
    </div>
  </div>

  <div class="little">
    <div class="little__head">
      <div>
        <div class="mono mono--accent" style="padding-bottom:12px">Little Books</div>
        <h2>Short-form, free to read</h2>
      </div>
      <p>Two pocket-sized volumes written for the PETRAS network. Free to download, no jargon, meant to be read in one sitting.</p>
    </div>
    <div class="little__grid">
      {% for b in books.little %}
      <div class="little__item">
        <a class="little__cover" href="{{ b.url }}">
          <img src="{{ b.cover }}" alt="{{ b.title }}" loading="lazy" />
        </a>
        <div class="little__body">
          <h3><a href="{{ b.url }}">{{ b.title }}</a></h3>
          <p>{{ b.blurb }}</p>
          <div class="mono little__meta">
            {{ b.authors }}<br />
            {{ b.specs[0] }} &middot; {{ b.specs[1] }}{% if b.isbn %} &middot; {{ b.isbn }}{% endif %}
          </div>
          <div class="little__links mono">
            <a href="{{ b.pdf }}">Download PDF &rarr;</a>
            <a href="{{ b.url }}">Read the post</a>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  <div class="booklet">
    <div class="mono mono--accent" style="padding-bottom:20px">Booklet</div>
    <div class="booklet__item">
      <a class="booklet__cover" href="{{ books.booklet.pdf }}">
        <img src="{{ books.booklet.cover }}" alt="{{ books.booklet.title }}" loading="lazy" />
      </a>
      <div class="booklet__body">
        <h2>{{ books.booklet.title }}</h2>
        <p class="booklet__sub">{{ books.booklet.sub }}</p>
        <div class="specs specs--light">{% for s in books.booklet.specs %}{% if s %}<span>{{ s }}</span>{% endif %}{% endfor %}</div>
        <p>{{ books.booklet.blurb }}</p>
        <div class="mono little__meta">{{ books.booklet.authors }}</div>
        <div class="little__links mono">
          <a href="{{ books.booklet.pdf }}">Download PDF &rarr;</a>
        </div>
      </div>
    </div>
  </div>

  <div style="height:88px"></div>
</div>
