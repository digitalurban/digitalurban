---
title: Projects & builds
permalink: /projects/
---
<div class="wrap">
  <div class="page-head">
    <h1>Projects &amp; builds</h1>
    <p>Physical devices, dashboards and models that turn urban and environmental data into something you can look at. Code is open where it can be.</p>
  </div>

  <div class="chips" style="padding:28px 0 48px">
    <span class="chip chip--on">All builds</span>
    {% for t in collections.tagList | head(8) %}
    <a class="chip" href="/tag/{{ t[2] }}/">{{ t[0] }}</a>
    {% endfor %}
  </div>

  <div class="tiles">
    {% for r in repos %}
    {% set post = collections.posts | findPost(r.match) %}
    <a class="tile" href="{{ r.url }}">
      <div class="tile__media">
        {% if post %}
          {% set img = post.data.hero or (post.templateContent | firstImage) %}
          {% if img %}<img src="{{ img }}" alt="" loading="lazy" />{% endif %}
        {% endif %}
      </div>
      <div class="tile__body">
        <div class="mono mono--accent" style="font-size:10px;letter-spacing:0.12em">{{ r.kind }}</div>
        <h3>{{ r.name }}</h3>
        <p>{{ r.blurb }}</p>
        <div class="tile__foot">{{ r.foot }}</div>
      </div>
    </a>
    {% endfor %}
  </div>
  <div style="height:80px"></div>
</div>
